// Item definitions. See BUILD_GUIDE.md §6.
//
// weight is in tenths: 30 = 3.0. Carry up to 25.0 freely, 38.0 burdened.
// frequency: spawn weight on floors in `depth` range; 0 = never found lying about.
// stack: (min, max) count when found. Stackable items share one pack slot.
// accuracy adds to the acolyte's base accuracy of 80.
[
    // ── Melee ────────────────────────────────────────────────────────────
    (
        id: "iron_candlestick",
        name: "iron candlestick",
        plural: "iron candlesticks",
        glyph: '/',
        color: (150, 140, 128),
        description: "Heavy enough to matter. You took it from the altar on your way down. It remembers holding a light: it hits harder while your candle burns.",
        class: Melee(family: Bludgeon, damage: (2, 5), accuracy: 5, quirk: Some(Candlelit(damage: 1))),
        weight: 30,
        depth: (1, 3),
        frequency: 1,
    ),
    (
        id: "sickle",
        name: "sickle",
        plural: "sickles",
        glyph: '/',
        color: (176, 176, 168),
        description: "A churchyard sickle, light and quick. Easy to land, never a heavy blow, but the wounds it opens keep bleeding.",
        class: Melee(family: Blade, damage: (2, 4), accuracy: 12, quirk: Some(Bleeds(turns: 4))),
        weight: 20,
        depth: (1, 6),
        frequency: 6,
    ),
    (
        id: "cleaver",
        name: "cleaver",
        plural: "cleavers",
        glyph: '/',
        color: (190, 180, 170),
        description: "From the almshouse kitchen. Bites deep when it bites at all, and what it kills is half-butchered already: it renders richer.",
        class: Melee(family: Blade, damage: (3, 6), accuracy: 0, quirk: Some(Butchers)),
        weight: 30,
        depth: (2, 8),
        frequency: 5,
