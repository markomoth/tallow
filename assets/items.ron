        weight: 40,
        depth: (1, 8),
        frequency: 4,
    ),
    (
        id: "censer",
        name: "censer on a chain",
        plural: "censers on chains",
        glyph: '/',
        color: (200, 168, 96),
        description: "Brass, swung on three feet of chain, still full of coals. Wild, and terrible when it connects: its best blows spill fire.",
        class: Melee(family: Bludgeon, damage: (3, 8), accuracy: -5, quirk: Some(Kindles)),
        weight: 50,
        depth: (3, 12),
        frequency: 3,
