    (
        id: "verger_staff",
        name: "verger's staff",
        plural: "verger's staffs",
        glyph: '/',
        color: (150, 112, 72),
        description: "A long rod of office, capped in brass. Steady in the hand, and made for moving people along: a hit drives them back a step.",
