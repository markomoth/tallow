    (
        id: "boathook",
        name: "boathook",
        plural: "boathooks",
        glyph: '/',
        color: (140, 120, 96),
        description: "For hauling things out of the drowned stacks. Long, heavy, and sure: a hit hooks the creature and hauls it in.",
