// Rites (BUILD_GUIDE.md §5). Each changes a situation; none only does damage.
//
// cost: dread spent when cast (before the school's thrift and boons).
// recharge: turns before the rite can be cast again.
// range: Chebyshev tiles to the target; 0 for rites cast on yourself.
// The effect's numbers are at 1.0× potency. Potency grows with dread:
// calm 1.0×, uneasy 1.25×, frayed or worse 1.5×, and with the school's
// Deepen technique. Durations count the target's actions or whole turns.
[
    (
        id: "compel",
        name: "Compel",
        school: Binding,
        description: "Speak the old command into a creature's ear. It fights for you, follows you, and remembers when it wakes.",
        cost: 15,
        recharge: 80,
        range: 6,
        effect: Compel(actions: 12),
    ),
    (
        id: "kneel",
        name: "Kneel",
        school: Binding,
        description: "A creature's legs forget how to carry it. It can still strike whatever is beside it.",
        cost: 8,
        recharge: 30,
        range: 6,
        effect: Kneel(actions: 5),
    ),
    (
        id: "leech",
        name: "Leech",
        school: Communion,
        description: "Draw the warmth out of a creature and into your own wounds.",
        cost: 10,
        recharge: 40,
        range: 4,
        effect: Leech(amount: 5),
    ),
    (
        id: "transference",
        name: "Transference",
        school: Communion,
        description: "Give your dread to another. It runs from what it now feels. A creature can carry your dread only once.",
        cost: 0,
        recharge: 60,
        range: 5,
        effect: Transference(dread: 20, actions: 8),
    ),
    (
        id: "borrowed_eyes",
        name: "Borrowed Eyes",
        school: Communion,
        description: "For a while you also see what a creature sees, lit or not.",
        cost: 6,
        recharge: 60,
        range: 8,
        effect: BorrowedEyes(turns: 30, radius: 7),
    ),
    (
        id: "unsee",
        name: "Unsee",
        school: Veil,
        description: "A creature forgets you were ever there, and for a while cannot notice you.",
        cost: 6,
        recharge: 30,
        range: 6,
        effect: Unsee(actions: 10),
    ),
    (
        id: "false_flame",
        name: "False Flame",
        school: Veil,
        description: "A light that isn't. Creatures near it go to it and ignore you unless you come close. Lantern-eaters will eat it.",
        cost: 8,
        recharge: 50,
        range: 8,
        effect: FalseFlame(turns: 20),
    ),
    (
        id: "shroud",
        name: "Shroud",
        school: Veil,
        description: "Your candle still burns, but no one sees it. Only what is beside you notices you.",
        cost: 8,
        recharge: 40,
        range: 0,
        effect: Shroud(turns: 15),
    ),
    (
        id: "sanctify",
        name: "Sanctify",
        school: Warding,
        description: "The ground around you remembers it was holy. The Dreaming cannot cross it. The Taken flinch when they step on it.",
        cost: 12,
        recharge: 60,
        range: 0,
        effect: Sanctify(turns: 30, radius: 2),
    ),
    (
        id: "exorcise",
        name: "Exorcise",
        school: Warding,
        description: "Cast the dreamer out of one of the Taken. They wake, and run home. The strongest only burn.",
        cost: 15,
        recharge: 40,
        range: 3,
        effect: Exorcise(damage: 8),
    ),
    (
        id: "turncoat",
        name: "Turncoat",
        school: Binding,
        description: "Whisper a lie into a creature: its own kind are its enemies now, and they know it. It still hates you.",
        cost: 12,
        recharge: 60,
        range: 6,
        effect: Turncoat,
    ),
    (
        id: "beckon",
        name: "Beckon",
        school: Binding,
        description: "A creature walks to you, calm, heedless of fire and oil on the way. When it reaches you, it wakes.",
        cost: 6,
        recharge: 25,
        range: 7,
        effect: Beckon(actions: 6),
    ),
    (
        id: "exchange",
        name: "Exchange",
        school: Communion,
        description: "You and a creature you can see trade places.",
        cost: 8,
        recharge: 20,
        range: 6,
        effect: Exchange,
    ),
    (
        id: "hush",
        name: "Hush",
        school: Veil,
        description: "Your fighting makes no sound. Nothing comes to see.",
        cost: 4,
        recharge: 50,
        range: 0,
        effect: Hush(turns: 25),
    ),
    (
        id: "seal",
        name: "Seal",
        school: Warding,
        description: "A door you can see swings shut and holds. Nothing but you can open it until the seal lapses. Fire still burns it.",
        cost: 6,
        recharge: 40,
        range: 5,
        effect: Seal(turns: 40),
    ),
    (
        id: "banish",
        name: "Banish",
        school: Warding,
        description: "Send a creature of the Dreaming back into the dark, far from you on this floor. It forgets you, for now.",
        cost: 10,
        recharge: 50,
        range: 6,
        effect: Banish,
    ),
]
